SECRET_KEY=change-me-to-a-long-random-string
ADMIN_PASSWORD=choose-a-strong-admin-password
SITE_URL=https://your-domain.com
SESSION_COOKIE_SECURE=false
TRUST_PROXY=true
SITE_NAME=People's Pick
TWITTER_HANDLE=
SECURITY_CONTACT=
DATABASE_URL=sqlite:///poll.db

# IntaSend (dashboard -> Developers -> API keys). Use test keys + INTASEND_TEST_MODE=true first.
INTASEND_SECRET_KEY=
INTASEND_PUBLISHABLE_KEY=
INTASEND_TEST_MODE=true
# Any long random string. Enter the SAME string as the "challenge" when you add the webhook in IntaSend.
INTASEND_WEBHOOK_CHALLENGE=

VOTE_PRICE_KES=10
